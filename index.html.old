    <!-- Hero Section -->
    <section
      id="home"
      class="pt-24 pb-16 md:pt-32 md:pb-24"
      style="background-image: url('https://readdy.ai/api/search-image?query=abstract%2520modern%2520professional%2520background%2520with%2520soft%2520blue%2520gradient%252C%2520subtle%2520geometric%2520patterns%252C%2520clean%2520and%2520minimalist%2520design%252C%2520perfect%2520for%2520portfolio%2520website%252C%2520light%2520colors%2520with%2520white%2520space%2520on%2520the%2520left%2520side%2520for%2520text%2520content%252C%2520professional%2520atmosphere&width=1920&height=600&seq=hero123&orientation=landscape'); background-size: cover; background-position: center;"
    >
      <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row items-center w-full">
          <div class="md:w-1/2 text-left">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
              Mong Phan
            </h1>
            <h2 class="text-xl md:text-2xl font-semibold text-primary mb-6">
              Full Stack Developer
            </h2>
            <p class="text-gray-600 mb-8 max-w-lg">
              Passionate developer with 5+ years of experience creating elegant
              solutions to complex problems. Specialized in building scalable
              web applications with modern technologies.
            </p>
            <div class="flex space-x-4">
              <a
                href="#projects"
                class="px-6 py-3 bg-primary text-white font-medium !rounded-button shadow-md hover:bg-primary/90 transition-colors whitespace-nowrap"
                >View Projects</a
              >
              <a
                href="#contact"
                class="px-6 py-3 border border-primary text-primary font-medium !rounded-button hover:bg-primary/5 transition-colors whitespace-nowrap"
                >Contact Me</a
              >
            </div>
          </div>
          <div
            class="md:w-1/2 mt-12 md:mt-0 flex justify-center md:justify-end"
          >
            <div class="relative w-64 h-64 md:w-80 md:h-80">
              <div
                class="absolute inset-0 bg-primary/10 rounded-full -rotate-6"
              ></div>
              <img
                src="./img/hinh_CV.png"
                alt="Mong Phan"
                class="absolute inset-0 w-full h-full object-cover rounded-full border-4 border-white shadow-lg"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
